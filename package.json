{
  "name": "shitajicss-monorepo",
  "version": "7.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "docs",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w shitajicss",
    "docs": "npm run build && minista ./docs",
    "docs:build": "npm run build && minista build ./docs",
    "docs:preview": "minista preview ./docs",
    "docs:check": "tsc -p docs/tsconfig.json --noEmit",
    "play": "vite ./play/_default",
    "audit": "npx npm-audit-trace",
    "up": "npx npm-check-updates --deep",
    "up:u": "npx npm-check-updates --deep -u",
    "rev": "npx npm-replace-versions",
    "release": "npm publish -w shitajicss"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "minista": "^5.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
